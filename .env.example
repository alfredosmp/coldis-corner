# Opcional: si colocas aquí tu Google OAuth Client ID antes de ejecutar `npm run build:win`,
# el instalador de Windows (.exe) y la versión móvil (PWA) ya vendrán preconfigurados para que
# Mafecita solo tenga que dar clic en "Conectar con Google Drive" una sola vez.

VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
